# Configuración de Claves de Stripe para ME-SIM Headless
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample

# Claves WooCommerce REST API (Opcional)
WOOCOMMERCE_API_URL=https://example.com
WOOCOMMERCE_CONSUMER_KEY=ck_sample
WOOCOMMERCE_CONSUMER_SECRET=cs_sample

# Configuración de Servidor de Correo SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASSWORD=your_secure_password_here

# Webhook bridge secret key for signature verification
ME_SIM_BRIDGE_SECRET=your_bridge_secret_key_here
