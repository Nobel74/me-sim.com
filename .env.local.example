# Configuración de Claves de Stripe para ME-SIM Headless
# Consigue tus claves en https://dashboard.stripe.com/apikeys

# Clave Publicable de Stripe (Cliente Next.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Clave Secreta de Stripe (Servidor Next.js API)
STRIPE_SECRET_KEY=sk_test_51...

# Claves WooCommerce REST API (Opcional)
WOOCOMMERCE_API_URL=https://me-sim.com
WOOCOMMERCE_CONSUMER_KEY=ck_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...

# Configuración de Servidor de Correo SMTP (mail.me-sim.com)
SMTP_HOST=mail.me-sim.com
SMTP_PORT=465
SMTP_USER=info@me-sim.com
SMTP_PASSWORD=TU_CONTRASEÑA_AQUÍ
